<mvc:View
	controllerName="org.sapux.int.controller.MainView"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:g="sap.suite.ui.commons.networkgraph"
    xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">
	<Page
		showHeader="false"
		enableScrolling="false"
		showNavButton="false">
		<content>
            <l:ResponsiveSplitter defaultPane="contePane" height="100%">
                <l:PaneContainer>
                    <l:SplitPane id="monitorGraphPane">
                        <g:Graph  enableWheelZoom="false"
                            id="graph"
                            height="100%"
                            width="100%"
                            selectionChange="onGraphSelectionChange"
                            orientation="{viewState>/landscapeOrientation}"
                            nodes="{/nodes}"
                            lines="{/lines}"
                            groups="{/groups}">
                            <g:statuses>
                                <g:Status key="CustomStatus" backgroundColor="darkblue" />
                            </g:statuses>
                            <g:nodes>
                                <g:Node
                                        key="{key}"
                                        title="{title}"
                                        group="{group}"
                                        icon="{icon}"
                                        attributes="{path:'attributes', templateShareable:true}"
                                        showActionLinksButton="false"
                                        status="{status}"
                                        headerCheckBoxState="{checkboxState}"
                                        shape="Box">
                                    <g:attributes>
                                        <g:ElementAttribute
                                                label="{label}"
                                                value="{value}"/>
                                    </g:attributes>
                                </g:Node>
                            </g:nodes>
                            <g:lines>
                                <g:Line
                                        from="{from}"
                                        to="{to}"
                                        attributes="{path:'attributes', templateShareable:true}"
                                        status="{status}">
                                    <g:attributes>
                                        <g:ElementAttribute
                                                label="{label}"
                                                value="{value}"/>
                                    </g:attributes>
                                </g:Line>
                            </g:lines>
                            <g:groups>
                                <g:Group
                                    headerCheckBoxState="{headerCheckboxState}"
                                    status="{status}"
                                    icon="sap-icon://measure"
                                    collapsed="{collapsed}"
                                    key="{key}"
                                    title="{title}">
                                </g:Group>
                            </g:groups>
                        </g:Graph>
                     </l:SplitPane>
                    <l:SplitPane id="monitorAlertsPane">   
                        <l:layoutData>
                            <l:SplitterLayoutData size="{viewState>/resourceTreeWidth}" />
                        </l:layoutData>
                        <Panel class="sapUiNoContentPadding" height="100%">
                            <table:TreeTable
									id="TreeTableBasic"
									rows="{path:'resourceTree>/value/c', parameters: {arrayNames:['c']}}"
									selectionMode="MultiToggle"
									rowMode="Auto"
									enableSelectAll="false"
									ariaLabelledBy="title">
								<table:extension>
									<OverflowToolbar style="Clear">
										<SearchField id="treeFilter" width="45%" change="onTreeFilterChange"/>
										<ToolbarSpacer/>
										<Button icon="sap-icon://synchronize" press="onRefeshResources" enabled="true"
                                            text="Refresh" tooltip="Refresh content resources list from all connected Content Agent services" />
										<Button icon="sap-icon://expand-all" press="onExpandAll"/>
										<Button icon="sap-icon://collapse-all" press="onCollapseAll"/>
										<Button icon="sap-icon://expand-group" press="onExpandSelection"/>
										<Button icon="sap-icon://collapse-group" press="onCollapseSelection"/>
									</OverflowToolbar>
								</table:extension>
								<table:rowSettingsTemplate>
                                    <table:RowSettings highlight="{
                                        path: 'resourceTree>s',
                                        formatter: '.formatter.statusHighlight'
                                    }" highlightText="{resourceTree>s}"/>
                                </table:rowSettingsTemplate>
								<table:columns>
									<table:Column width="16rem">
										<Label text="Content Resources"/>
										<table:template>
                                            <Link text="{resourceTree>n}" wrapping="false" 
                                                href="{resourceTree>/value/repoUrl}{resourceTree>p}" target="_blank"/>
										</table:template>
									</table:Column>
                                    <table:Column width="5rem">
										<Label text="ID"/>
										<table:template>
											<Text text="{resourceTree>i}" wrapping="false" />
										</table:template>
									</table:Column>
									<table:Column width="7rem">
										<Label text="Sub-Type"/>
										<table:template>
											<Text text="{resourceTree>t}" wrapping="false" />
										</table:template>
									</table:Column>
									<table:Column width="5rem">
										<Label text="STG"/>
										<table:template>
											<Text text="{resourceTree>v0}" wrapping="false" />
										</table:template>
									</table:Column>
                                    <table:Column width="5rem">
										<Label text="PRE2"/>
										<table:template>
											<Text text="{resourceTree>v1}" wrapping="false" />
										</table:template>
									</table:Column>
                                    <table:Column width="5rem">
										<Label text="PRE3"/>
										<table:template>
											<Text text="{resourceTree>v2}" wrapping="false" />
										</table:template>
									</table:Column>
                                    <table:Column width="5rem">
										<Label text="PRE"/>
										<table:template>
											<Text text="{resourceTree>v3}" wrapping="false" />
										</table:template>
									</table:Column>
								</table:columns>
							</table:TreeTable>
                        </Panel>
                    </l:SplitPane>
                </l:PaneContainer>
            </l:ResponsiveSplitter> 
		</content>
	</Page>
</mvc:View>
