<mvc:View controllerName="org.sapux.int.controller.App"
    height="100%"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
  	xmlns:core="sap.ui.core"
	xmlns:tnt="sap.tnt" >
	<tnt:ToolPage id="toolPage">
		<tnt:header>
			<f:ShellBar 
                title="Integration DevOps"
				secondTitle="v{buildInfo>/version/version}-{buildInfo>/version/commit} ({buildInfo>/version/build})"
                homeIcon="./favicon.png"
				showMenuButton="true"
				showNotifications="false"
				menuButtonPressed="onMenuButtonPress"
                homeIconPressed="onHomeIconPress">
				<f:menu>
					<Menu>
						<MenuItem text="Integration Landscape" icon="sap-icon://flight" />
					</Menu>
				</f:menu>
				<f:profile>
					<Avatar 
						id="userAvatar"
						initials="{userInfo>/initial}"
						showBorder="true"
						press="onUserAvatarPress"/>
				</f:profile>
				<!--f:searchManager>
					<f:SearchManager/>
				</f:searchManager-->
                <f:additionalContent>
					<Switch state="false" customTextOn="Live" customTextOff="Demo" enabled="false" 
						tooltip="DEMO mode uses static/fake data (no authorization needed); LIVE mode reads actual system landscape &amp; artifacts data (viewer/operator role required)">
						<layoutData>
							<FlexItemData growFactor="1" />
						</layoutData>
					</Switch>
                    <OverflowToolbarButton id="themeToggleBtn" text="Change Theme" icon="sap-icon://dark-mode" press="onToggleTheme" 
						tooltip="Toggle between dark/light theme" />
                </f:additionalContent>
			</f:ShellBar>
		</tnt:header>
		<tnt:sideContent>
			<SideNavigation xmlns="sap.tnt" xmlns:core="sap.ui.core" expanded="true" selectedKey="{comp>/currentRouteName}">
				<NavigationList items="{path: '/navigation'}">
					<NavigationListItem xmlns="sap.tnt" text="{title}" icon="{icon}" enabled="{enabled}" href="{url}" target="{target}" expanded="{expanded}" items="{path: 'items', templateShareable:true}"
								key="{key}">
						<NavigationListItem text="{title}" key="{key}" enabled="{enabled}" href="{url}" target="{target}" />
					</NavigationListItem>
				</NavigationList>
				<fixedItem>
					<NavigationList items="{path: '/fixedNavigation'}">
						<NavigationListItem xmlns="sap.tnt" text="{title}" icon="{icon}" enabled="{enabled}" href="{url}" target="{target}" expanded="{expanded}" items="{path: 'items', templateShareable:true}"
								key="{key}">
							<NavigationListItem text="{title}" key="{key}" enabled="{enabled}" href="{url}" target="{target}"/>
						</NavigationListItem>
					</NavigationList>
				</fixedItem>
			</SideNavigation>
		</tnt:sideContent>
		<tnt:mainContents>
			<NavContainer id="pageContainer">
				<pages>
					
				</pages>
			</NavContainer>
		</tnt:mainContents>
	</tnt:ToolPage>
</mvc:View>
