{
	"_version": "1.49.0",
	"sap.app": {
		"id": "org.sapux.int",
		"type": "application",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"applicationVersion": {
			"version": "0.8.0"
		},
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				"en"
			],
			"fallbackLocale": "en"
		},
		"sourceTemplate": {
			"id": "@sap/generator-fiori:basic",
			"version": "1.11.0",
			"toolsId": "3a849e6f-143f-4991-ac96-a3e637ae3dc9"
		},
		"dataSources": {},
		"crossNavigation": {
			"inbounds": {
				"IntDevOps-main": {
					"semanticObject": "IntDevOps",
					"action": "main",
					"title": "{{flpTitle}}",
					"subTitle": "{{flpSubtitle}}",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": false,
		"dependencies": {
			"minUI5Version": "1.120.8",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.f": {},
				"sap.suite.ui.commons": {},
				"sap.tnt": {},
				"sap.ui.comp": {},
				"sap.ui.generic.app": {},
				"sap.ui.table": {},
				"sap.ui.layout": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "org.sapux.int.i18n.i18n",
					"supportedLocales": [
						"en"
					],
					"fallbackLocale": "en"
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewType": "XML",
				"async": true,
				"viewPath": "org.sapux.int.view",
				"controlAggregation": "pages",
				"controlId": "pageContainer",
				"clearControlAggregation": false,
				"path": "org.sapux.int.view"
			},
			"routes": [
				{
					"name": "Main",
					"pattern": ":?query:",
					"target": "Main"
				},
				{
					"name": "Router",
					"pattern": "router",
					"target": "Router"
				}
			],
			"targets": {
				"Main": {
					"viewType": "XML",
					"transition": "slide",
					"clearControlAggregation": false,
					"viewId": "MainView",
					"viewName": "MainView"
				},
				"Router": {
					"viewType": "XML",
					"transition": "slide",
					"clearControlAggregation": false,
					"viewId": "RouterView",
					"viewName": "RouterView"
				}
			}
		},
		"rootView": {
			"viewName": "org.sapux.int.view.App",
			"type": "XML",
			"async": true,
			"id": "app"
		}
	}
}