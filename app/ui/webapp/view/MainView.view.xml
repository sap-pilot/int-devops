<mvc:View
	controllerName="org.sapux.int.controller.MainView"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:g="sap.suite.ui.commons.networkgraph"
    xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">
	<Page
		showHeader="false"
		enableScrolling="false"
		showNavButton="false">
		<content>
            <l:ResponsiveSplitter defaultPane="contePane" height="100%">
                <l:PaneContainer>
                    <l:SplitPane id="landscapePane">
                        <g:Graph enableWheelZoom="false"
                            id="graph"
                            height="100%"
                            width="100%"
                            busy="{viewState>/busy}"
                            selectionChange="onGraphSelectionChange"
                            orientation="{appState>/landscapeOrientation}"
                            nodes="{landscape>/nodes}"
                            lines="{landscape>/lines}"
                            groups="{landscape>/groups}">
                            <g:statuses>
                                <g:Status key="CustomStatus" backgroundColor="darkblue" />
                            </g:statuses>
                            <g:nodes>
                                <g:Node
                                        key="{landscape>idx}"
                                        title="{landscape>tmsNode}"
                                        group="{landscape>group}"
                                        icon="{landscape>icon}"
                                        attributes="{path:'landscape>attrs', templateShareable:true}"
                                        showActionLinksButton="false"
                                        status="{landscape>status}"
                                        headerCheckBoxState="{landscape>checkboxState}"
                                        selected="{landscape>selected}"
                                        press="onNodePress"
                                        shape="Box">
                                    <g:attributes>
                                        <g:ElementAttribute
                                                label="{landscape>key}"
                                                value="{landscape>value}"/>
                                    </g:attributes>
                                </g:Node>
                            </g:nodes>
                            <g:lines>
                                <g:Line
                                        from="{landscape>from}"
                                        to="{landscape>to}"
                                        attributes="{path:'landscape>attributes', templateShareable:true}"
                                        status="{landscape>status}">
                                    <g:attributes>
                                        <g:ElementAttribute
                                                label="{label}"
                                                value="{value}"/>
                                    </g:attributes>
                                </g:Line>
                            </g:lines>
                            <g:groups>
                                <g:Group
                                    headerCheckBoxState="{landscape>headerCheckboxState}"
                                    status="{landscape>status}"
                                    collapsed="{landscape>collapsed}"
                                    key="{landscape>idx}"
                                    title="{landscape>name}">
                                </g:Group>
                            </g:groups>
                        </g:Graph>
                     </l:SplitPane>
                    <l:SplitPane id="resourceTreePane">   
                        <l:layoutData>
                            <l:SplitterLayoutData size="{appState>/resourceTreeWidth}" />
                        </l:layoutData>
                        <Panel class="sapUiNoContentPadding" height="100%">
                            <table:TreeTable
									id="resourceTreeTable"
                                    busy="{viewState>/busy}"
                                    busyIndicatorDelay="0"
									rows="{path:'resourceTree>/value/c', parameters: {arrayNames:['c']}}"
									selectionMode="MultiToggle"
									rowMode="Auto"
                                    rowSelectionChange="onTreeSelectionChange"
									enableSelectAll="false"
									ariaLabelledBy="title">
								<table:extension>
									<OverflowToolbar style="Clear">
										<SearchField id="treeFilter" width="18rem" 
                                            enabled="{=!${viewState>/busy}}"
                                            change="onTreeFilterChange"/>
										<ToolbarSpacer/>
										<Button icon="sap-icon://expand-all" press="onExpandAll"/>
										<Button icon="sap-icon://collapse-all" press="onCollapseAll"/>
										<!-- <Button icon="sap-icon://expand-group" press="onExpandSelection"/>
										<Button icon="sap-icon://collapse-group" press="onCollapseSelection"/> -->
                                        <Button id="refreshBtn" 
                                            press="loadContentResources(true)"
                                            enabled="{=!${viewState>/busy}}"
                                            text="{=${viewState>/busy}?'Loading...':'Refresh'}" 
                                            icon="sap-icon://synchronize" 
                                            tooltip="Force refresh content resources list from all connected Content Agent services" />
                                        <Button id="exportBtn" 
                                            enabled="false"
                                            text="Export (0)" 
                                            icon="sap-icon://shipping-status" 
                                            tooltip="Export selected artifacts to TMS" />
									</OverflowToolbar>
								</table:extension>
								<table:rowSettingsTemplate>
                                    <table:RowSettings highlight="{
                                        path: 'resourceTree>s',
                                        formatter: '.formatter.statusHighlight'
                                    }" highlightText="{resourceTree>s}"/>
                                </table:rowSettingsTemplate>
								<table:columns>
									<table:Column width="16rem">
										<Label text="Content Resources"/>
										<table:template>
                                            <Link text="{resourceTree>n}" wrapping="false" 
                                                href="{resourceTree>/value/repoUrl}{resourceTree>p}" target="_blank"/>
										</table:template>
									</table:Column>
                                    <table:Column width="5rem">
										<Label text="ID"/>
										<table:template>
											<Text text="{resourceTree>i}" wrapping="false" />
										</table:template>
									</table:Column>
									<table:Column width="7rem">
										<Label text="Sub-Type"/>
										<table:template>
											<Text text="{resourceTree>t}" wrapping="false" />
										</table:template>
									</table:Column>
									<!-- <table:Column width="5rem">
										<Label text="STG"/>
										<table:template>
											<Text text="{resourceTree>v0}" wrapping="false" />
										</table:template>
									</table:Column> -->
								</table:columns>
							</table:TreeTable>
                        </Panel>
                    </l:SplitPane>
                </l:PaneContainer>
            </l:ResponsiveSplitter> 
		</content>
	</Page>
</mvc:View>
