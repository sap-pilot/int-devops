<mvc:View
	controllerName="org.sapux.int.controller.RouterView"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:g="sap.suite.ui.commons.networkgraph"
    xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">
	<Page
		showHeader="false"
		enableScrolling="false"
		showNavButton="false">
		<content>
            <l:ResponsiveSplitter defaultPane="contePane" height="100%">
                <l:PaneContainer>
                    <l:SplitPane id="routerGraphPane">
                        <g:Graph enableWheelZoom="false"
                            id="graph"
                            height="100%"
                            width="100%"
                            busy="{viewState>/busy}"
                            selectionChange="onGraphSelectionChange"
                            orientation="{appState>/routerLandscapeOrientation}"
                            nodes="{routerLandscape>/nodes}"
                            lines="{routerLandscape>/lines}"
                            groups="{routerLandscape>/groups}">
                            <g:statuses>
                                <g:Status key="CustomStatus" backgroundColor="darkblue" />
                            </g:statuses>
                            <g:nodes>
                                <g:Node
                                        key="{routerLandscape>key}"
                                        title="{routerLandscape>title}"
                                        group="{routerLandscape>group}"
                                        icon="{routerLandscape>icon}"
                                        attributes="{path:'routerLandscape>attributes', templateShareable:true}"
                                        showActionLinksButton="true"
                                        showDetailButton="false"
                                        status="{routerLandscape>status}"
                                        headerCheckBoxState="{routerLandscape>checkboxState}"
                                        selected="{routerLandscape>selected}"
                                        press="onNodePress"
                                        width="180"
                                        shape="Box">
                                    <g:attributes>
                                        <g:ElementAttribute
                                                label="{routerLandscape>label}"
                                                value="{routerLandscape>value}"/>
                                    </g:attributes>
                                </g:Node>
                            </g:nodes>
                            <g:lines>
                                <g:Line
                                        from="{routerLandscape>from}"
                                        to="{routerLandscape>to}"
                                        lineType="{routerLandscape>lineType}"
                                        attributes="{path:'routerLandscape>attributes', templateShareable:true}"
                                        status="{routerLandscape>status}">
                                    <g:attributes>
                                        <g:ElementAttribute
                                                label="{routerLandscape>label}"
                                                value="{routerLandscape>value}"/>
                                    </g:attributes>
                                </g:Line>
                            </g:lines>
                            <g:groups>
                                <g:Group
                                    headerCheckBoxState="{routerLandscape>headerCheckboxState}"
                                    status="{routerLandscape>status}"
                                    collapsed="{routerLandscape>collapsed}"
                                    key="{routerLandscape>key}"
                                    title="{routerLandscape>title}">
                                </g:Group>
                            </g:groups>
                        </g:Graph>
                     </l:SplitPane>
                    <l:SplitPane id="routerRulesPane">   
                        <l:layoutData>
                            <l:SplitterLayoutData size="{appState>/routerRulesWidth}" />
                        </l:layoutData>
                        <Panel class="sapUiNoContentPadding" height="100%">
                            <table:Table
                                rows="{routerRules>/rules}"
                                selectionMode="MultiToggle"
                                rowMode="Auto"
                                ariaLabelledBy="title">
                                <table:extension>
                                    <OverflowToolbar style="Clear">
                                        <Title id="title" text="Routing Rules"/>
                                    </OverflowToolbar>
                                </table:extension>
                                <table:columns>
                                    <table:Column width="9rem">
                                        <Label text="cvx-env" />
                                        <table:template>
                                            <ComboBox value="{routerRules>route}" items="{ path: 'routerRules>/routes', templateShareable: false }" width="100%">
                                                <core:Item text="{routerRules>route}"/>
                                            </ComboBox>
                                            <!-- <m:Input value="{routerRules>route}"/> -->
                                        </table:template>
                                    </table:Column>
                                    <table:Column width="11rem" >
                                        <Label text="system-alias" />
                                        <table:template>
                                            <ComboBox value="{routerRules>alias}" items="{ path: 'routerRules>/systemAlias', templateShareable: false }" width="100%">
                                                <core:Item text="{routerRules>alias}"/>
                                            </ComboBox>
                                        </table:template>
                                    </table:Column>
                                     <table:Column width="16rem">
                                        <Label text="destination" />
                                        <table:template>
                                            <ComboBox value="{routerRules>destination}" items="{ path: 'routerRules>/destinations', templateShareable: false }" width="100%">
                                                <core:Item text="{routerRules>name}"/>
                                            </ComboBox>
                                        </table:template>
                                    </table:Column>
                                </table:columns>
                            </table:Table>
                        </Panel>
                    </l:SplitPane>
                </l:PaneContainer>
            </l:ResponsiveSplitter> 
		</content>
	</Page>
</mvc:View>
