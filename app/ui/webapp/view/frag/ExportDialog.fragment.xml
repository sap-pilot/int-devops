<core:FragmentDefinition
	xmlns="sap.m"
    xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core"
	xmlns:table="sap.ui.table">
	<Dialog title="Export ({casResources>/value/selectedTransportableEntries}) selected artifacts"
        resizable="true" draggable="true" contentWidth="980px" contentHeight="700px" 
        horizontalScrolling="false" verticalScrolling="false">
		<content>
			<VBox class="sapUiSmallMargin sapUiNoMarginTop">
                <f:Form id="exportForm" editable="true">
                    <!-- <f:layout>
                        <f:ColumnLayout
                            columnsS="1"
                            columnsM="2"
                            columnsL="2"
                            columnsXL="2"
                        />
                    </f:layout> -->
                    <f:layout>
                    <f:ResponsiveGridLayout
                        labelSpanXL="3"
                        labelSpanL="3"
                        labelSpanM="3"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="3"
                        columnsL="3"
                        columnsM="3"
                        columnsS="1"
                        singleContainerFullSize="false" />
                    </f:layout>
                    <f:formContainers>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="Source">
                                    <f:fields>
                                        <Select
                                            forceSelection="false"
                                            required="true"
                                            editable="{=!${viewState>/busyExporting}}"
                                            valueState="{=${casExport>/sourceNode} === '' ? 'Error' : 'None'}"
                                            valueStateText="Select source node with content agent connected"
                                            selectedKey="{casExport>/sourceNode}"
                                            change=".onExportParamsChange"
                                            items="{
                                                path: 'casResources>/allowExportNodes',
                                                sorter: { path: 'tmsNode' }
                                            }">
                                            <core:Item key="{casResources>tmsNode}" text="{casResources>tmsNode}" />
                                        </Select>
                                    </f:fields>
                                </f:FormElement>
                             </f:formElements>
                        </f:FormContainer>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="Target">
                                    <f:fields>
                                        <Select
                                            forceSelection="false"
                                            required="true"
                                            editable="{=!${viewState>/busyExporting}}"
                                            valueState="{=${casExport>/targetNode} === '' ? 'Error' : 'None'}"
                                            valueStateText="Select target TMS node with upload allowed"
                                            selectedKey="{casExport>/targetNode}"
                                            change=".onExportParamsChange"
                                            items="{
                                                path: 'casResources>/allowUploadNodes',
                                                sorter: { path: 'tmsNode' }
                                            }">
                                            <core:Item key="{casResources>tmsNode}" text="{casResources>tmsNode}" />
                                        </Select>
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="Note">
                                    <f:fields>
                                        <Input value="{casExport>/description}" required="true" 
                                            change=".onExportParamsChange"
                                            editable="{=!${viewState>/busyExporting}}"
                                            valueState="{=${casExport>/description} === '' ? 'Error' : 'None'}"
                                            valueStateText="Describe the content eg: 'Util package from {casExport>/sourceNode}'"
                                            placeholder="Enter transport description" />
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>
                <MessageStrip
                    text="{casExport>/result/message}"
                    type="{casExport>/result/type}"
                    visible="{=!${viewState>/busyExporting}}"
                    showCloseButton="false"
                    showIcon="true">
                    <link>
                        <Link text="Content Agent Log"
                            visible="{= ${casExport>/result/tr} !== undefined}"
                            target="_blank"
                            href="https://ncfaws-24.us10.content-agent.cloud.sap/index.html#/activityDetails/6558f6c4-2bd6-11f0-91d8-eeee0a84b499" />
                        <Link text="TR: {casExport>/result/tr}"
                            visible="{= ${casExport>/result/tr} !== undefined}"
                            target="_blank"
                            href="{casResources>/value/tmsUrl}#/transportRequest/{casExport>/result/tr}" />
                    </link>
                </MessageStrip>
                <ProgressIndicator
                        id="exportProgress"
                        state="Success"
                        visible="{viewState>/busyExporting}"
                        displayValue="Export in progress: 66%"
                        percentValue="66"
                        showValue="true"
                        displayOnly="true"
                        displayAnimation="true" />
                <table:TreeTable
                    id="exportTreeTable"
                    busy="{viewState>/busy}"
                    busyIndicatorDelay="0"
                    rows="{path:'casExport>/contentResources/c', parameters: {arrayNames:['c']}}"
                    selectionMode="None"
                    enableSelectAll="false"
                    width="100%"
                    ariaLabelledBy="title">
                    <table:rowMode>
                        <rowmodes:Interactive rowCount="17" xmlns:rowmodes="sap.ui.table.rowmodes" />
                    </table:rowMode>
                    <table:rowSettingsTemplate>
                        <table:RowSettings highlight="{
                            path: 'casExport>s',
                            formatter: '.formatter.statusHighlight'
                        }" highlightText="{casExport>s}"/>
                    </table:rowSettingsTemplate>
                    <table:columns>
                        <table:Column width="24rem">
                            <Label text="Content Resources"/>
                            <table:template>
                                <Link text="{casExport>n}" wrapping="false" 
                                    href="{casResources>/value/repoUrl}{casExport>p}" target="_blank"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="17rem">
                            <Label text="ID"/>
                            <table:template>
                                <Text text="{casExport>i}" wrapping="false" />
                            </table:template>
                        </table:Column>
                        <table:Column width="6rem">
                            <Label text="Sub-Type/Type"/>
                            <table:template>
                                <Text text="{=${casExport>st} === undefined? ${casExport>t} : ${casExport>st}}" wrapping="false" />
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:TreeTable>
            </VBox>
		</content>
		<footer>
			<Toolbar>
				<content>
					<ToolbarSpacer />
					<Button
						icon="sap-icon://shipping-status"
						type="Emphasized"
						text="Export to TMS"
						tooltip="Export selected artifacts to TMS"
						press=".onExportToTMS()" 
                        enabled="{=!${viewState>/busyExporting} &amp;&amp; ${casExport>/sourceNode} !== '' &amp;&amp; ${casExport>/targetNode} !== '' &amp;&amp;${casExport>/description} !== '' &amp;&amp; ${casExport>/result/counter/valid} > 0}"/>
					<Button 
						text="Close"
						press=".closeExportDialog" />
				</content>
			</Toolbar>
		</footer>
	</Dialog>
</core:FragmentDefinition>