{
	"welcomeFile": "/ui/index.html",
	"authenticationMethod": "route",
	"sessionTimeout": 120,
	"logout": {
		"logoutEndpoint": "/do/logout",
		"logoutPage": "/public/logout.html"
	},
	"routes": [
		{
            "source": "^/user-api(.*)$",
            "target": "$1.json",
            "localDir": "../../ui/webapp/model",
			"authenticationType": "none",
			"cacheControl": "max-age=0, must-revalidate"
        },
		{
            "source": "^/srv/cas(.*)$",
            "target": "demo.json",
            "localDir": "../dist/ui/",
			"authenticationType": "none",
			"cacheControl": "max-age=0, must-revalidate"
        },
		{
			"source": "^/tms(.*)$",
			"target": "$1",
			"localDir": "../public",
			"authenticationType": "none",
			"cacheControl": "max-age=0, must-revalidate"
		},
		{
			"source": "^/favicon(.*)$",
			"target": "favicon$1",
			"localDir": "../dist/ui/",
			"authenticationType": "none"
		},
		{
			"source": "^/public(.*)$",
			"target": "$1",
			"localDir": "../public",
			"authenticationType": "none"
		},
		{
			"source": "^/ui(.*)$",
			"target": "$1",
			"localDir": "../dist/ui",
			"authenticationType": "none",
			"cacheControl": "max-age=0, must-revalidate"
		}
	]
}